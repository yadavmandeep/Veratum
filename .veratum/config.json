{
  "schema": "veratum.config/v1",
  "enforcement": "strict",
  "trivial_bypass": false,
  "read_before_write": true,
  "max_retries": 2,
  "compact_max_lines": 40,
  "verify_timeout_sec": 1800,
  "stop_gate_max_blocks": 3,
  "fingerprint_exclude": [],
  "protected_paths": [
    ".veratum/ledger.json",
    ".veratum/contract.json",
    ".veratum/baseline.json",
    ".veratum/state.json",
    ".veratum/snapshots/*"
  ],
  "installed_adapters": [
    "claude-code",
    "antigravity"
  ],
  "python": "python",
  "graph_auto": "auto",
  "installed_version": "1.3.1"
}
